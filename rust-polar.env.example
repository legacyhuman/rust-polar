# Copy these settings into the service manager environment; do not put secrets here.
RUST_POLAR_DATA_DIR=/var/lib/rust-polar
RUST_POLAR_SOCKET=/var/lib/rust-polar/run/rust-polar.sock

# Default polling interval: 30 minutes. Accepted range: 30 seconds to 30 days.
RUST_POLAR_SYNC_INTERVAL_SECONDS=1800

# Explicit redb page cache. Accepted range: 1 MiB to 256 MiB.
RUST_POLAR_DB_CACHE_BYTES=8388608

# Require this much free SSD space before starting an archive response.
RUST_POLAR_MIN_FREE_BYTES=536870912
